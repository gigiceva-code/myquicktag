{
  "rewrites": [
    {
      "source": "/u/:username/profile",
      "destination": "/profile.html?u=:username"
    },
    {
      "source": "/u/:username/manifest.json",
      "destination": "/api/manifest?u=:username"
    },
    {
      "source": "/u/:username",
      "destination": "/tag.html?u=:username"
    }
  ]
}
